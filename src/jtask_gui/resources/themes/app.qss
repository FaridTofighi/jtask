/* jtask-gui stylesheet template. @token@ placeholders are filled from
   theme.palette(); this keeps QSS and Python-side colour roles in lockstep. */

QWidget {
    background-color: @bg@;
    color: @text@;
    font-size: 14px;
}

QMainWindow, QDialog { background-color: @bg@; }

/* ---- headings / muted text via objectName ---- */
QLabel#H1  { font-size: 22px; font-weight: 700; }
QLabel#H2  { font-size: 17px; font-weight: 700; }
QLabel#Muted { color: @text_muted@; }
QLabel#Badge {
    color: @primary_fg@; background-color: @primary@;
    border-radius: 8px; padding: 2px 10px; font-weight: 700;
}

/* ---- buttons ---- */
QPushButton {
    background-color: @surface@;
    border: 1px solid @border@;
    border-radius: 8px;
    padding: 6px 14px;
}
QPushButton:hover { background-color: @hover@; }
QPushButton:pressed { background-color: @selection@; }
QPushButton#Primary {
    background-color: @primary@;
    color: @primary_fg@;
    border: none;
    font-weight: 700;
}
QPushButton#Primary:hover { background-color: @accent@; }
QPushButton:disabled { color: @text_muted@; }

/* ---- inputs ---- */
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, QTimeEdit {
    background-color: @bg_alt@;
    border: 1px solid @border@;
    border-radius: 8px;
    padding: 6px 10px;
    selection-background-color: @selection@;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QComboBox:focus, QSpinBox:focus, QTimeEdit:focus {
    border: 1px solid @primary@;
}
QComboBox::drop-down { border: none; width: 20px; }

/* ---- table / trees / lists ---- */
QTableView, QTreeView, QListView {
    background-color: @bg@;
    alternate-background-color: @bg_alt@;
    border: 1px solid @border@;
    border-radius: 10px;
    gridline-color: @border@;
    selection-background-color: @selection@;
    selection-color: @text@;
    outline: 0;
}
QHeaderView::section {
    background-color: @bg_alt@;
    color: @text_muted@;
    border: none;
    border-bottom: 1px solid @border@;
    padding: 8px 10px;
    font-weight: 700;
}
QTableView::item { padding: 6px 10px; }

/* ---- sidebar ---- */
QTreeWidget#Sidebar {
    background-color: @bg_alt@;
    border: none;
    border-left: 1px solid @border@;
    font-size: 14px;
}
QTreeWidget#Sidebar::item { padding: 7px 6px; border-radius: 6px; }
QTreeWidget#Sidebar::item:selected { background-color: @selection@; color: @text@; }
QTreeWidget#Sidebar::item:hover { background-color: @hover@; }

/* ---- chips ---- */
QFrame#Chip {
    background-color: @selection@;
    border: 1px solid @border@;
    border-radius: 11px;
    padding: 1px 6px;
}
QFrame#Chip QToolButton { border: none; background: transparent; color: @text_muted@; }

/* ---- detail panel ---- */
QWidget#DetailPanel {
    background-color: @bg_alt@;
    border-left: 1px solid @border@;
}

/* ---- console ---- */
QPlainTextEdit#ConsoleOutput {
    font-family: "Vazirmatn", monospace;
    background-color: @bg@;
}

/* ---- toolbar / status ---- */
QToolBar { background-color: @bg_alt@; border: none; spacing: 8px; padding: 6px; }
QStatusBar { background-color: @bg_alt@; color: @text_muted@; }
QToolTip {
    background-color: @surface@; color: @text@;
    border: 1px solid @border@; border-radius: 6px; padding: 4px 8px;
}

/* ---- scrollbars ---- */
QScrollBar:vertical { background: transparent; width: 12px; margin: 2px; }
QScrollBar::handle:vertical { background: @border@; border-radius: 5px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: @text_muted@; }
QScrollBar:horizontal { background: transparent; height: 12px; margin: 2px; }
QScrollBar::handle:horizontal { background: @border@; border-radius: 5px; min-width: 30px; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }

/* ---- placeholder ---- */
QWidget#Placeholder QLabel { color: @text_muted@; }
