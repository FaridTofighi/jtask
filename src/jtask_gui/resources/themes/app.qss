/* jtask-gui stylesheet template.

   Two placeholder families, both filled by theme.render_qss():
     @<colour>@  — from theme.palette()  (bg, text, primary, overdue, …)
     @sp_N@ / @fs_*@ / @r_*@  — from tokens.qss_tokens()  (the design scale)

   Spacing scale (tokens.SPACE):  2 · 4 · 6 · 8 · 10 · 12 · 14 · 16 · 20 · 24
   Type scale     (tokens.FONT_SIZE):  h1 22 · title 16 · lg 15 · body 14 · h2 13 · xs 12
   Radius         (tokens.RADIUS):  sm 6 · md 8 · pill 9 · lg 12

   Elevation layers (palette):  bg (window) < bg_alt (sidebar) < surface (cards,
   rows, buttons) < elevated (dialogs, menus, popovers).  Inputs use `field`.

   No raw px padding/margin/spacing/font-size/border-radius value may be added
   here — tests/gui/test_qss_uses_tokens.py enforces it. 0 / 1px / 2px are the
   only bare lengths allowed.
*/

/* ============================ base ============================ */
* { outline: 0; }

QWidget {
    background-color: @bg@;
    color: @text@;
    font-family: "Vazirmatn";
    font-size: @fs_body@;
}
QMainWindow { background-color: @bg@; }
QMainWindow::separator { background: @border_soft@; width: 1px; height: 1px; }
QWidget#ContentFrame { background-color: @bg@; }

QLabel { background: transparent; }
QLabel#H1 { font-size: @fs_h1@; font-weight: 700; letter-spacing: 0; }
QLabel#H2 { font-size: @fs_h2@; font-weight: 700; color: @text@; padding: @sp_2@ 0; }
QLabel#Section {
    font-size: @fs_xs@; font-weight: 700; color: @text_muted@;
    letter-spacing: 1px; padding: @sp_4@ 0;
}
QLabel#Muted { color: @text_muted@; font-size: @fs_xs@; }
QLabel#FieldLabel { color: @text_muted@; font-weight: 700; }
QLabel#Badge {
    color: @primary_fg@; background-color: @primary@;
    border-radius: @r_pill@; padding: @sp_4@ @sp_12@; font-weight: 700; font-size: @fs_xs@;
}

/* ============================ dialogs (raised) ================ */
QDialog { background-color: @elevated@; }
QDialog > QWidget, QDialog QFrame, QDialog QScrollArea,
QDialog QScrollArea > QWidget > QWidget { background-color: @elevated@; }
QDialog QLineEdit, QDialog QTextEdit, QDialog QPlainTextEdit, QDialog QComboBox,
QDialog QSpinBox, QDialog QDoubleSpinBox, QDialog QTimeEdit,
QDialog QAbstractItemView {
    background-color: @field@;
}
QDialog QPushButton { background-color: @surface@; }
QDialog QPushButton#Primary { background-color: @primary@; }
QDialog QPushButton#Primary:hover { background-color: @primary_hi@; }
QDialog QPushButton#Danger { background-color: @overdue@; }

/* ============================ buttons ======================== */
QPushButton {
    background-color: @surface@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: @r_md@;
    padding: @sp_8@ @sp_16@;
    min-height: 18px;
}
QPushButton:hover { background-color: @hover@; border-color: @text_muted@; }
QPushButton:pressed { background-color: @selection@; }
QPushButton:focus { border-color: @focus@; }
QPushButton:disabled { color: @text_muted@; background-color: @bg_alt@; border-color: @border_soft@; }
QPushButton#Primary {
    background-color: @primary@; color: @primary_fg@;
    border: none; font-weight: 700; padding: @sp_8@ @sp_20@;
}
QPushButton#Primary:hover { background-color: @primary_hi@; }
QPushButton#Primary:pressed { background-color: @accent@; }
QPushButton#Primary:disabled { background-color: @bg_alt@; color: @text_muted@; }

QToolButton {
    background: transparent; border: 1px solid transparent;
    border-radius: @r_md@; padding: @sp_6@;
}
QToolButton:hover { background-color: @hover@; }
QToolButton:pressed { background-color: @selection@; }
QToolButton:checked { background-color: @primary_soft@; border-color: @primary@; }
QToolButton:focus { border-color: @focus@; }

/* the one emphasised toolbar action — "New task" */
QToolButton#PrimaryAction {
    background-color: @primary@; color: @primary_fg@;
    font-weight: 700; padding: @sp_6@ @sp_12@;
}
QToolButton#PrimaryAction:hover { background-color: @primary_hi@; }
QToolButton#PrimaryAction:pressed { background-color: @accent@; }

QToolButton#DetailStar { border: none; background: transparent; padding: @sp_2@; }
QToolButton#DetailStar:hover { background-color: @hover@; border-radius: @r_sm@; }

/* ============================ inputs ======================== */
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTimeEdit {
    background-color: @field@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: @r_md@;
    padding: @sp_8@ @sp_12@;
    selection-background-color: @primary@;
    selection-color: @primary_fg@;
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover, QTimeEdit:hover {
    border-color: @text_muted@;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QTimeEdit:focus {
    border-color: @focus@;
    background-color: @field_focus@;
}
QLineEdit:disabled { color: @text_muted@; background: @bg_alt@; }
QLineEdit[invalid="true"], QLineEdit[invalid="true"]:focus { border-color: @overdue@; }
QLineEdit#QuickAdd {
    font-size: @fs_lg@; padding: @sp_10@ @sp_14@; border-radius: @r_lg@;
}
QLineEdit#FilterEdit { font-family: "Vazirmatn"; }

QComboBox::drop-down { border: none; width: 22px; }
QTimeEdit[compact="true"] { padding: @sp_6@ @sp_6@; }
QComboBox QAbstractItemView {
    background-color: @elevated@;
    border: 1px solid @border@;
    border-radius: @r_md@;
    selection-background-color: @primary_soft@;
    selection-color: @text@;
    padding: @sp_4@;
}

/* ============================ table ========================= */
QTableView {
    background-color: @surface@;
    alternate-background-color: @row_alt@;
    border: 1px solid @border@;
    border-radius: @r_lg@;
    gridline-color: transparent;
    selection-background-color: @selection@;
    selection-color: @text@;
}
QTableView::item {
    padding: @sp_10@ @sp_12@;
    border: none;
    border-bottom: 1px solid @row_line@;
}
/* selection is background-only — one continuous band across the whole row.
   The leading-edge accent bar is painted by TaskTable.paintEvent (direction
   aware) so it never renders as a per-cell border. */
QTableView::item:hover { background-color: @hover@; }
QTableView::item:selected { background-color: @selection@; }
QTableView::item:selected:hover { background-color: @selection@; }
QHeaderView { background: transparent; }
QHeaderView::section {
    background-color: @bg_alt@;
    color: @text_muted@;
    border: none;
    border-bottom: 1px solid @border@;
    padding: @sp_12@ @sp_12@;
    font-weight: 700;
    font-size: @fs_xs@;
}
QHeaderView::section:hover { color: @text@; }
QTableView QTableCornerButton::section { background: @bg_alt@; border: none; }

/* ============================ sidebar ====================== */
QTreeWidget#Sidebar {
    background-color: @bg_alt@;
    border: none;
    border-right: 1px solid @border@;
    padding: @sp_8@ @sp_8@;
    font-size: @fs_body@;
}
QTreeWidget#Sidebar::item {
    padding: @sp_8@ @sp_10@;
    margin: 1px 0;
    border-radius: @r_md@;
    color: @text@;
}
QTreeWidget#Sidebar::item:selected {
    background-color: @primary_soft@; color: @primary@; font-weight: 700;
}
QTreeWidget#Sidebar::item:hover:!selected { background-color: @hover@; }
QTreeWidget#Sidebar::branch { background: transparent; }

QFrame#SidebarDivider { background-color: @border_soft@; max-height: 1px; margin: @sp_8@ @sp_4@; }
QLabel#ReportsEntry {
    font-weight: 700; padding: @sp_8@ @sp_10@; border-radius: @r_md@;
    color: @text@;
}
QLabel#ReportsEntry:hover { background-color: @hover@; }

/* ============================ chips ======================== */
QFrame#Chip {
    background-color: @chip_bg@;
    border: 1px solid @chip_border@;
    border-radius: @r_pill@;
    padding: @sp_2@ @sp_4@ @sp_2@ @sp_10@;
}
QFrame#Chip QLabel { color: @chip_fg@; font-size: @fs_xs@; font-weight: 700; }
QFrame#Chip QToolButton { padding: 1px; color: @chip_fg@; }
QFrame#Chip QToolButton:hover { background-color: @overdue@; color: @on_danger@; border-radius: @r_md@; }

/* ============================ panels ======================= */
QScrollArea#DetailScroll { border: none; border-left: 1px solid @border@; background-color: @bg_alt@; }
QScrollArea#DetailScroll > QWidget > QWidget { background-color: @bg_alt@; }
QWidget#DetailPanel { background-color: @bg_alt@; }
QWidget#DetailPanel QLabel { background: transparent; }
QWidget#DetailPanel QLineEdit,
QWidget#DetailPanel QComboBox,
QWidget#DetailPanel QPlainTextEdit { background-color: @field@; }
QFrame#DetailHeader { border-bottom: 1px solid @border@; }

QLabel#EmptyState { color: @text_muted@; font-size: @fs_lg@; background: transparent; }

/* annotations tab — each note is its own wrapped, tinted card */
QWidget#AnnotationsView { background-color: @bg_alt@; }
QListWidget#AnnotationsList {
    background: transparent;
    border: none;
}
QFrame#AnnotationCard {
    background-color: @bg_alt@;
    border: 1px solid @border_soft@;
    border-radius: @r_md@;
}
QFrame#AnnotationCard[tint="1"] { background-color: @note_tint_1@; }
QFrame#AnnotationCard[tint="2"] { background-color: @note_tint_2@; }
QFrame#AnnotationCard[tint="3"] { background-color: @note_tint_3@; }
QFrame#AnnotationCard[tint="4"] { background-color: @note_tint_4@; }
/* selection is background-only, same convention as a table row (no border artifact) */
QFrame#AnnotationCard[selected="true"] { background-color: @selection@; border-color: @selection@; }
QLabel#AnnotationWhen { color: @text_muted@; font-size: @fs_xs@; background: transparent; }
QLabel#AnnotationBody { color: @text@; background: transparent; }
QPlainTextEdit#AnnotationInput {
    background-color: @field@;
    border: 1px solid @border@;
    border-radius: @r_md@;
    padding: @sp_8@;
}
QPlainTextEdit#AnnotationInput:focus { border-color: @focus@; }
QLabel#DepEmpty { color: @text_muted@; font-size: @fs_h2@; background: transparent; }
QGraphicsView { border: 1px solid @border@; border-radius: @r_md@; background: @surface@; }

/* ---- calendar report ---- */
QFrame#DayCell { background: @surface@; border: 1px solid @border_soft@; border-radius: @r_md@; }
QFrame#DayCell:hover { border-color: @primary@; }
QFrame#DayCell QLabel { background: transparent; }

/* ---- reports & charts rail ---- */
QListWidget#Sidebar { background-color: @bg_alt@; border: none; border-right: 1px solid @border@; }
QProgressBar {
    background-color: @field@; border: 1px solid @border_soft@; border-radius: @r_pill@;
    height: 18px; text-align: center; color: @text@;
}
QProgressBar::chunk { background-color: @primary@; border-radius: @r_pill@; }

/* ---- segmented control ---- */
QPushButton#Segment {
    background: @field@; border: 1px solid @border@;
    padding: @sp_6@ @sp_14@; border-radius: 0; font-weight: 700; color: @text_muted@;
}
QPushButton#Segment[pos="first"] { border-top-right-radius: @r_md@; border-bottom-right-radius: @r_md@; }
QPushButton#Segment[pos="last"] { border-top-left-radius: @r_md@; border-bottom-left-radius: @r_md@; border-right: none; }
QPushButton#Segment[pos="mid"] { border-right: none; }
QPushButton#Segment[pos="only"] { border-radius: @r_md@; }
QPushButton#Segment:hover { background: @hover@; color: @text@; }
QPushButton#Segment:checked { background: @primary@; color: @primary_fg@; border-color: @primary@; }

QWidget#Placeholder { background-color: @bg@; }
QWidget#Placeholder QLabel#H1 { color: @text@; }
QWidget#Placeholder QLabel#Body { color: @text_muted@; font-size: @fs_body@; line-height: 150%; }

/* ============================ toolbars ==================== */
/* the toolbar is a visually distinct region (@bg_alt@ + a bottom rule),
   not blended into the content — consistent with d4's cluster grouping. */
QToolBar {
    background-color: @bg_alt@;
    border: none;
    border-bottom: 1px solid @border@;
    spacing: @sp_8@;
    padding: @sp_8@ @sp_12@;
}
QToolBar#RowOne { padding-bottom: @sp_4@; border-bottom: none; }
QToolBar#RowTwo { padding-top: @sp_4@; }
QToolBar::separator { background: @border@; width: 1px; margin: @sp_4@ @sp_8@; }
QLabel#ToolLabel { color: @text_muted@; font-weight: 700; font-size: @fs_xs@; }

/* ============================ status bar ================== */
QStatusBar {
    background-color: @bg_alt@;
    border-top: 1px solid @border@;
    color: @text_muted@;
    padding: @sp_4@ @sp_12@;
}
QStatusBar::item { border: none; }
QStatusBar QLabel { color: @text_muted@; font-size: @fs_xs@; }
QLabel#StatusCount { color: @text@; font-weight: 700; font-size: @fs_body@; }
QLabel#StatusOk { color: @text_muted@; }
QLabel#StatusBad { color: @overdue@; font-weight: 700; }

/* ============================ dock ======================= */
QDockWidget {
    titlebar-close-icon: none; titlebar-normal-icon: none;
    color: @text_muted@; font-weight: 700; font-size: @fs_xs@;
}
QDockWidget::title {
    background: @bg_alt@;
    padding: @sp_8@ @sp_12@;
    border-bottom: 1px solid @border_soft@;
}

/* ============================ tooltip / menu (raised) ==== */
QToolTip {
    background-color: @elevated@; color: @text@;
    border: 1px solid @border@; border-radius: @r_sm@; padding: @sp_4@ @sp_8@;
}
QMenu {
    background-color: @elevated@; border: 1px solid @border@;
    border-radius: @r_md@; padding: @sp_4@;
}
QMenu::item { padding: @sp_8@ @sp_24@; border-radius: @r_sm@; }
QMenu::item:selected { background-color: @primary_soft@; }
QMenu::separator { height: 1px; background: @border_soft@; margin: @sp_4@ @sp_8@; }

/* ============================ command palette ============ */
QDialog#CommandPalette {
    background-color: @elevated@;
    border: 1px solid @border@;
    border-radius: @r_lg@;
}
QLineEdit#PaletteInput {
    background-color: @field@;
    border: 1px solid @border@;
    border-radius: @r_md@;
    padding: @sp_10@ @sp_12@;
    font-size: @fs_lg@;
}
QLineEdit#PaletteInput:focus { border-color: @focus@; background-color: @field_focus@; }
QListWidget#PaletteList {
    background-color: transparent;
    border: none;
}
QListWidget#PaletteList::item {
    padding: @sp_8@ @sp_10@;
    border-radius: @r_sm@;
    color: @text@;
}
QListWidget#PaletteList::item:selected {
    background-color: @primary_soft@;
    color: @primary@;
}

/* ============================ board engine ============== */
QWidget#BoardView { background-color: @bg@; }
QScrollArea#Board { background: transparent; border: none; }
QScrollArea#BoardColScroll { background: transparent; border: none; }
QFrame#BoardColumn {
    background-color: @bg_alt@;
    border: 1px solid @border_soft@;
    border-radius: @r_lg@;
    min-width: 230px;
}
QFrame#BoardColumn[dropTarget="true"] { border-color: @primary@; }
QLabel#BoardColTitle {
    color: @text_muted@; font-weight: 700; font-size: @fs_xs@;
    padding: @sp_2@ @sp_4@;
}
QLabel#BoardColSub {
    color: @text_muted@; font-size: @fs_xs@;
    padding: 0 @sp_4@ @sp_2@ @sp_4@;
}
/* per-column accent strip — a curated theme role, hidden when the column has
   no colour (boards.COLUMN_ACCENT_ROLES) */
QFrame#BoardColAccent {
    min-height: 3px; max-height: 3px;
    border: none; border-radius: @r_sm@;
    background-color: transparent;
}
QFrame#BoardColAccent[accent="primary"]  { background-color: @primary@; }
QFrame#BoardColAccent[accent="accent"]   { background-color: @accent@; }
QFrame#BoardColAccent[accent="success"]  { background-color: @success@; }
QFrame#BoardColAccent[accent="due_soon"] { background-color: @due_soon@; }
QFrame#BoardColAccent[accent="overdue"]  { background-color: @overdue@; }
QFrame#BoardColAccent[accent="blocked"]  { background-color: @blocked@; }
QFrame#BoardColAccent[accent="waiting"]  { background-color: @waiting@; }
QFrame#BoardCard {
    background-color: @surface@;
    border: 1px solid @border@;
    border-radius: @r_md@;
}
QFrame#BoardCard[priority="H"] { border-left: 2px solid @overdue@; }
QFrame#BoardCard[priority="M"] { border-left: 2px solid @due_soon@; }
QLabel#CardTitle { color: @text@; }
QLabel#CardMeta { color: @text_muted@; font-size: @fs_xs@; }
QToolButton#CardStar { border: none; background: transparent; padding: 0; }

/* ============================ weekly review wizard ====== */
QWidget#ReviewWizard { background-color: @bg_alt@; }
QListWidget#ReviewStuckList {
    background-color: @surface@;
    border: 1px solid @border_soft@;
    border-radius: @r_md@;
}

/* ============================ triage mode =============== */
QWidget#TriageView { background-color: @bg@; }
QWidget#TriageCard {
    background-color: @surface@;
    border: 1px solid @border@;
    border-radius: @r_lg@;
}
QPushButton#TriageColButton { padding: @sp_8@ @sp_16@; font-weight: 700; }
QToolButton#BoardColTriage, QToolButton#BoardColSort {
    border: none; background: transparent; padding: 0;
}
QToolButton#BoardColSort::menu-indicator { image: none; width: 0; }
QPushButton#DangerButton { color: @overdue@; }

/* ============================ shortcut cheat sheet ======= */
QDialog#ShortcutSheet { background-color: @elevated@; }
QScrollArea#SheetScroll { background: transparent; border: none; }
QLabel#KeyCap {
    background-color: @field@;
    border: 1px solid @border@;
    border-radius: @r_sm@;
    padding: @sp_2@ @sp_8@;
    color: @text_muted@;
    font-size: @fs_xs@;
}

/* ============================ scrollbars ================= */
QScrollBar:vertical { background: transparent; width: 10px; margin: @sp_2@; }
QScrollBar::handle:vertical { background: @border@; border-radius: @r_sm@; min-height: 32px; }
QScrollBar::handle:vertical:hover { background: @text_muted@; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: @sp_2@; }
QScrollBar::handle:horizontal { background: @border@; border-radius: @r_sm@; min-width: 32px; }
QScrollBar::handle:horizontal:hover { background: @text_muted@; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ============================ splitter =================== */
QSplitter::handle { background: @border@; }
QSplitter::handle:horizontal { width: 3px; }
QSplitter::handle:hover { background: @primary@; }

/* ============================ console ==================== */
/* the Raw Command Console is a terminal — a dark surface in every theme. */
QWidget#CommandConsole { background-color: @console_bg@; }
QPlainTextEdit#ConsoleOutput {
    font-family: "DejaVu Sans Mono", "Vazirmatn", monospace;
    font-size: @fs_h2@;
    background-color: @console_bg@;
    color: @console_fg@;
    border: 1px solid @console_border@;
    border-radius: @r_md@;
    padding: @sp_8@;
    selection-background-color: @console_prompt@;
    selection-color: @console_bg@;
}
QPlainTextEdit#ConsoleOutput QScrollBar:vertical { background: transparent; width: 10px; }
QPlainTextEdit#ConsoleOutput QScrollBar::handle:vertical { background: @console_border@; border-radius: @r_sm@; }
QLineEdit#ConsoleInput {
    font-family: "DejaVu Sans Mono", "Vazirmatn", monospace;
    font-size: @fs_h2@;
    background-color: @console_bg@;
    color: @console_fg@;
    border: 1px solid @console_border@;
    border-radius: @r_md@;
    padding: @sp_8@ @sp_10@;
}
QLineEdit#ConsoleInput:focus { border-color: @console_prompt@; background-color: @console_bg@; }
QLineEdit#ConsoleInput::placeholder { color: @waiting@; }

/* ============================ error dialog ============== */
QLabel#ErrorMessage { font-size: @fs_body@; line-height: 150%; }
QToolButton#ErrorDetailsToggle {
    color: @text_muted@; font-size: @fs_xs@; border: none; background: transparent;
    padding: @sp_2@ @sp_4@;
}
QToolButton#ErrorDetailsToggle:hover { color: @primary@; background: transparent; }
QPlainTextEdit#ErrorDetails {
    font-family: "DejaVu Sans Mono", "Vazirmatn", monospace; font-size: @fs_xs@;
    background-color: @surface@; border: 1px solid @border@; border-radius: @r_md@;
    color: @text_muted@;
}

/* ============================ confirm dialog ============ */
QLabel#ConfirmBody { font-size: @fs_h2@; line-height: 150%; }
QPlainTextEdit#ConfirmDetails {
    font-family: "DejaVu Sans Mono", "Vazirmatn", monospace; font-size: @fs_xs@;
    background-color: @surface@; border: 1px solid @border@; border-radius: @r_md@;
}
QPushButton#Danger {
    background-color: @overdue@; color: @on_danger@; border: 1px solid @overdue@;
    font-weight: 700;
}
QPushButton#Danger:hover { background-color: @blocked@; border-color: @blocked@; }
QPushButton#Danger:pressed { background-color: @accent@; border-color: @accent@; }
QPushButton#Danger:disabled {
    background-color: @bg_alt@; color: @overdue@; border: 1px solid @overdue@;
}

/* ============================ history / raw / stats / timesheet === */
QLabel#FormHint { color: @overdue@; font-size: @fs_xs@; }

QTreeWidget#HistoryTree, QTreeWidget#TimesheetTree {
    background-color: @surface@; border: 1px solid @border_soft@; border-radius: @r_md@;
}
QTreeWidget#HistoryTree::item, QTreeWidget#TimesheetTree::item { padding: @sp_4@ @sp_4@; }
QTreeWidget#HistoryTree QHeaderView::section,
QTreeWidget#TimesheetTree QHeaderView::section,
QTableWidget#StatsTable QHeaderView::section {
    background-color: @surface@; color: @text_muted@; border: none;
    border-bottom: 1px solid @border@; padding: @sp_4@ @sp_6@; font-weight: 700;
}
QTableWidget#StatsTable {
    background-color: @surface@; border: 1px solid @border_soft@; border-radius: @r_md@;
}
QTableWidget#StatsTable::item { padding: @sp_4@ @sp_8@; }

QPlainTextEdit#RawJson {
    font-family: "DejaVu Sans Mono", "Vazirmatn", monospace; font-size: @fs_xs@;
    background-color: @surface@; border: 1px solid @border@; border-radius: @r_md@;
}

QLabel#TimerIndicator {
    color: @primary_fg@; background-color: @primary@;
    border-radius: @r_pill@; padding: 1px @sp_8@; font-weight: 700;
}
QLabel#TimerIndicator:hover { background-color: @overdue@; color: @on_danger@; }

QTabWidget#DetailTabs::pane { border: none; }
QTabWidget#DetailTabs QTabBar::tab {
    background: transparent; color: @text_muted@; padding: @sp_8@ @sp_14@;
    border-bottom: 2px solid transparent;
}
QTabWidget#DetailTabs QTabBar::tab:selected {
    color: @text@; border-bottom: 2px solid @primary@;
}
QTabWidget#DetailTabs QTabBar::tab:hover:!selected { color: @text@; }

/* ============================ export / import / sync ============== */
QListWidget#ImportSample {
    background-color: @surface@; border: 1px solid @border_soft@; border-radius: @r_md@;
}
QListWidget#ImportSample::item { padding: @sp_4@ @sp_6@; }

/* ============================ Taskwarrior managers =============== */
QTableWidget#ConfigTable, QTableWidget#ContextTable,
QTableWidget#UdaTable, QTableWidget#ReportTable, QTableWidget#HookTable {
    background-color: @surface@; border: 1px solid @border_soft@; border-radius: @r_md@;
}
QTableWidget#ConfigTable::item, QTableWidget#ContextTable::item,
QTableWidget#UdaTable::item, QTableWidget#ReportTable::item,
QTableWidget#HookTable::item { padding: @sp_4@ @sp_8@; }
QTableWidget#ConfigTable QHeaderView::section,
QTableWidget#ContextTable QHeaderView::section,
QTableWidget#UdaTable QHeaderView::section,
QTableWidget#ReportTable QHeaderView::section,
QTableWidget#HookTable QHeaderView::section,
QTableWidget#HelpTable QHeaderView::section {
    background-color: @surface@; color: @text_muted@; border: none;
    border-bottom: 1px solid @border@; padding: @sp_4@ @sp_6@; font-weight: 700;
}

/* ============================ toast ============================= */
QFrame#Toast {
    background-color: @elevated@;
    border: 1px solid @border@;
    border-radius: @r_lg@;
}
QLabel#ToastText { color: @text@; font-size: @fs_body@; background: transparent; }
QLabel#ToastIcon { background: transparent; }

/* ============================ diagnostics / help / calc ========== */
QPlainTextEdit#DiagText {
    font-family: "DejaVu Sans Mono", "Vazirmatn", monospace; font-size: @fs_xs@;
    background-color: @surface@; border: 1px solid @border@; border-radius: @r_md@;
}
QTableWidget#HelpTable {
    background-color: @surface@; border: 1px solid @border_soft@; border-radius: @r_md@;
}
QTableWidget#HelpTable::item { padding: @sp_4@ @sp_8@; }
QLabel#CalcResult {
    font-size: @fs_title@; font-weight: 700; color: @primary@;
    padding: @sp_8@ @sp_2@;
}
