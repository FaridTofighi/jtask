/* jtask-gui stylesheet template.

   Two placeholder families, both filled by theme.render_qss():
     @<colour>@  — from theme.palette()  (bg, text, primary, overdue, …)
     @sp_N@ / @fs_*@ / @r_*@  — from tokens.qss_tokens()  (the design scale)

   Spacing scale (tokens.SPACE):  2 · 4 · 6 · 8 · 10 · 12 · 14 · 16 · 20 · 24 · 32
   Type scale     (tokens.FONT_SIZE):  h1 22 · title 16 · lg 15 · body 14 · h2 13 · xs 12
   Radius         (tokens.RADIUS):  sm 6 · md 8 · pill 9 · lg 12

   No raw px padding/margin/spacing/font-size/border-radius value may be added
   here — tests/gui/test_qss_uses_tokens.py enforces it. 0 / 1px / 2px (border
   and hairline widths) are the only bare lengths allowed.
*/

/* ============================ base ============================ */
* { outline: 0; }

QWidget {
    background-color: @bg@;
    color: @text@;
    font-family: "Vazirmatn";
    font-size: @fs_body@;
}
QMainWindow { background-color: @bg@; }
QMainWindow::separator { background: @border@; width: 1px; height: 1px; }

/* elevation: a dialog is a raised surface — @elevated@ fill (a visible lift off
   the window background in dark; neutral in light, which leans on the OS window
   frame). Popovers (QMenu, item views, tooltip) already carry the @surface@ +
   border treatment further down. Inputs/buttons keep their own fills so they
   still read as controls on the raised surface. */
QDialog { background-color: @elevated@; }
QDialog > QWidget, QDialog QFrame, QDialog QScrollArea,
QDialog QScrollArea > QWidget > QWidget { background-color: @elevated@; }
QDialog QLineEdit, QDialog QTextEdit, QDialog QPlainTextEdit, QDialog QComboBox,
QDialog QSpinBox, QDialog QDoubleSpinBox, QDialog QTimeEdit,
QDialog QAbstractItemView {
    background-color: @field@;
}
QDialog QPushButton { background-color: @surface@; }
QDialog QPushButton#Primary { background-color: @primary@; }
QDialog QPushButton#Primary:hover { background-color: @primary_hi@; }
QDialog QPushButton#Danger  { background-color: @overdue@; }

QLabel { background: transparent; }
QLabel#H1     { font-size: @fs_h1@; font-weight: 700; }
QLabel#Section{ font-size: @fs_xs@; font-weight: 700; color: @text_muted@;
                letter-spacing: 1px; }
QLabel#Muted  { color: @text_muted@; font-size: @fs_xs@; }
QLabel#Badge  {
    color: @primary_fg@; background-color: @primary@;
    border-radius: @r_pill@; padding: @sp_4@ @sp_12@; font-weight: 700; font-size: @fs_xs@;
}
QLabel#FieldLabel { color: @text_muted@; font-weight: 700; }

/* ============================ buttons ======================== */
QPushButton {
    background-color: @surface@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: @r_md@;
    padding: @sp_8@ @sp_16@;
    min-height: 18px;
}
QPushButton:hover   { background-color: @hover@; border-color: @primary@; }
QPushButton:pressed { background-color: @selection@; }
QPushButton:focus   { border: 1px solid @primary@; }
QPushButton:disabled{ color: @text_muted@; background-color: @bg_alt@; }
QPushButton#Primary {
    background-color: @primary@; color: @primary_fg@;
    border: none; font-weight: 700; padding: @sp_8@ @sp_20@;
}
QPushButton#Primary:hover  { background-color: @primary_hi@; }
QPushButton#Primary:pressed{ background-color: @accent@; }

QToolButton {
    background: transparent; border: 1px solid transparent;
    border-radius: @r_md@; padding: @sp_6@;
}
QToolButton:hover   { background-color: @hover@; }
QToolButton:pressed { background-color: @selection@; }
QToolButton:checked { background-color: @selection@; border-color: @primary@; }

/* ============================ inputs ======================== */
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTimeEdit {
    background-color: @field@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: @r_md@;
    padding: @sp_8@ @sp_12@;
    selection-background-color: @primary@;
    selection-color: @primary_fg@;
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QTimeEdit:hover { border-color: @text_muted@; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QTimeEdit:focus {
    border: 1px solid @primary@;
    background-color: @field_focus@;
}
QLineEdit:disabled { color: @text_muted@; background: @bg_alt@; }
QLineEdit[invalid="true"] { border: 1px solid @overdue@; }
QLineEdit[invalid="true"]:focus { border: 1px solid @overdue@; }
QLineEdit#QuickAdd { font-size: @fs_lg@; padding: @sp_8@ @sp_14@; }
QLineEdit#FilterEdit { font-family: "Vazirmatn"; }

QComboBox::drop-down { border: none; width: 22px; }
QTimeEdit[compact="true"] { padding: @sp_6@ @sp_6@; }
QComboBox QAbstractItemView {
    background-color: @surface@;
    border: 1px solid @border@;
    border-radius: @r_md@;
    selection-background-color: @selection@;
    selection-color: @text@;
    padding: @sp_4@;
}

/* ============================ table ========================= */
QTableView {
    background-color: @bg@;
    alternate-background-color: @bg_alt@;
    border: 1px solid @border@;
    border-radius: @r_lg@;
    gridline-color: transparent;
    selection-background-color: @selection@;
    selection-color: @text@;
}
QTableView::item {
    padding: @sp_8@ @sp_12@;
    border: none;
    border-bottom: 1px solid @row_line@;
}
QTableView::item:hover     { background-color: @hover@; }
QTableView::item:selected   { background-color: @selection@; }
QHeaderView { background: transparent; }
QHeaderView::section {
    background-color: @bg_alt@;
    color: @text_muted@;
    border: none;
    border-bottom: 2px solid @border@;
    padding: @sp_12@ @sp_12@;
    font-weight: 700;
    font-size: @fs_xs@;
}
QHeaderView::section:hover { color: @text@; }
QTableView QTableCornerButton::section { background: @bg_alt@; border: none; }

/* ============================ sidebar ====================== */
QTreeWidget#Sidebar {
    background-color: @bg_alt@;
    border: none;
    padding: @sp_8@ @sp_8@;
    font-size: @fs_body@;
}
QTreeWidget#Sidebar::item {
    padding: @sp_8@ @sp_8@;
    margin: 1px 0;
    border-radius: @r_md@;
    color: @text@;
}
QTreeWidget#Sidebar::item:selected { background-color: @primary@; color: @primary_fg@; }
QTreeWidget#Sidebar::item:hover:!selected { background-color: @hover@; }
QTreeWidget#Sidebar::branch { background: transparent; }

QFrame#SidebarDivider { background-color: @border@; max-height: 1px; margin: @sp_8@ @sp_4@; }
QLabel#ReportsEntry {
    font-weight: 700; padding: @sp_12@ @sp_8@; border-radius: @r_md@;
    background-color: @surface@; border: 1px solid @border@;
}
QLabel#ReportsEntry:hover { border-color: @primary@; }

/* ============================ chips ======================== */
QFrame#Chip {
    background-color: @chip_bg@;
    border: 1px solid @chip_border@;
    border-radius: @r_lg@;
    padding: @sp_2@ @sp_4@ @sp_2@ @sp_10@;
}
QFrame#Chip QLabel { color: @chip_fg@; font-size: @fs_xs@; font-weight: 700; }
QFrame#Chip QToolButton { padding: 1px; color: @chip_fg@; }
QFrame#Chip QToolButton:hover { background-color: @overdue@; color: @on_danger@; border-radius: @r_md@; }

/* ============================ panels ======================= */
QScrollArea#DetailScroll { border: none; background-color: @bg_alt@; }
QScrollArea#DetailScroll > QWidget > QWidget { background-color: @bg_alt@; }
QWidget#DetailPanel { background-color: @bg_alt@; border-left: 1px solid @border@; }
QWidget#DetailPanel QLabel { background: transparent; }
QWidget#DetailPanel QLineEdit,
QWidget#DetailPanel QComboBox,
QWidget#DetailPanel QPlainTextEdit { background-color: @field@; }
QFrame#DetailHeader { border-bottom: 1px solid @border@; }

QLabel#EmptyState { color: @text_muted@; font-size: @fs_lg@; background: transparent; }
QLabel#DepEmpty  { color: @text_muted@; font-size: @fs_h2@; background: transparent; }
QGraphicsView    { border: 1px solid @border@; border-radius: @r_md@; background: @bg@; }

/* ---- calendar report ---- */
QFrame#DayCell { background: @bg_alt@; border: 1px solid @row_line@; border-radius: @r_sm@; }
QFrame#DayCell:hover { border-color: @primary@; }
QFrame#DayCell QLabel { background: transparent; }

/* ---- reports & charts ---- */
QListWidget#Sidebar { background-color: @bg_alt@; border: none; border-right: 1px solid @border@; }
QProgressBar {
    background-color: @field@; border: 1px solid @border@; border-radius: @r_md@;
    height: 18px; text-align: center; color: @text@;
}
QProgressBar::chunk { background-color: @primary@; border-radius: @r_md@; }

/* ---- segmented control ---- */
QPushButton#Segment {
    background: @field@; border: 1px solid @border@;
    padding: @sp_6@ @sp_14@; border-radius: 0; font-weight: 700; color: @text_muted@;
}
QPushButton#Segment[pos="first"] { border-top-right-radius: @r_md@; border-bottom-right-radius: @r_md@; }
QPushButton#Segment[pos="last"]  { border-top-left-radius: @r_md@; border-bottom-left-radius: @r_md@; border-right: none; }
QPushButton#Segment[pos="mid"]   { border-right: none; }
QPushButton#Segment[pos="only"]  { border-radius: @r_md@; }
QPushButton#Segment:hover   { background: @hover@; color: @text@; }
QPushButton#Segment:checked {
    background: @primary@; color: @primary_fg@; border-color: @primary@;
}

QWidget#Placeholder { background-color: @bg@; }
QWidget#Placeholder QLabel#H1 { color: @text@; }
QWidget#Placeholder QLabel#Body { color: @text_muted@; font-size: @fs_body@; line-height: 150%; }

/* ============================ toolbars ==================== */
QToolBar {
    background-color: @bg_alt@;
    border: none;
    border-bottom: 1px solid @border@;
    spacing: @sp_8@;
    padding: @sp_8@ @sp_12@;
}
QToolBar#RowTwo { padding-top: @sp_4@; }
QToolBar::separator {
    background: @border@; width: 1px; margin: @sp_4@ @sp_8@;
}
QLabel#ToolLabel { color: @text_muted@; font-weight: 700; font-size: @fs_xs@; }

/* ============================ status bar ================== */
QStatusBar {
    background-color: @bg_alt@;
    border-top: 1px solid @border@;
    color: @text_muted@;
    padding: @sp_2@ @sp_10@;
}
QStatusBar::item { border: none; }
QStatusBar QLabel { color: @text_muted@; font-size: @fs_xs@; }
QLabel#StatusCount { color: @text@; font-weight: 700; }
QLabel#StatusOk    { color: @success@; }
QLabel#StatusBad   { color: @overdue@; font-weight: 700; }

/* ============================ dock ======================= */
QDockWidget {
    titlebar-close-icon: none;
    color: @text_muted@;
    font-weight: 700;
    font-size: @fs_xs@;
}
QDockWidget::title {
    background: @bg_alt@;
    padding: @sp_8@ @sp_12@;
    border-bottom: 1px solid @border@;
}

/* ============================ tooltip / menu ============= */
QToolTip {
    background-color: @surface@; color: @text@;
    border: 1px solid @primary@; border-radius: @r_sm@; padding: @sp_4@ @sp_8@;
}
QMenu {
    background-color: @surface@; border: 1px solid @border@;
    border-radius: @r_md@; padding: @sp_4@;
}
QMenu::item { padding: @sp_8@ @sp_24@; border-radius: @r_sm@; }
QMenu::item:selected { background-color: @selection@; }
QMenu::separator { height: 1px; background: @border@; margin: @sp_4@ @sp_8@; }

/* ============================ scrollbars ================= */
QScrollBar:vertical { background: transparent; width: 12px; margin: @sp_2@; }
QScrollBar::handle:vertical { background: @border@; border-radius: @r_sm@; min-height: 32px; }
QScrollBar::handle:vertical:hover { background: @text_muted@; }
QScrollBar:horizontal { background: transparent; height: 12px; margin: @sp_2@; }
QScrollBar::handle:horizontal { background: @border@; border-radius: @r_sm@; min-width: 32px; }
QScrollBar::handle:horizontal:hover { background: @text_muted@; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ============================ splitter =================== */
QSplitter::handle { background: @border@; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:hover { background: @primary@; }

/* ============================ console ==================== */
QPlainTextEdit#ConsoleOutput {
    font-family: "Vazirmatn", "DejaVu Sans Mono", monospace;
    background-color: @bg@; border: 1px solid @border@; border-radius: @r_md@;
}
QLineEdit#ConsoleInput { font-family: "Vazirmatn", "DejaVu Sans Mono", monospace; }

/* ============================ error dialog ============== */
QLabel#ErrorMessage { font-size: @fs_body@; line-height: 150%; }
QToolButton#ErrorDetailsToggle {
    color: @text_muted@; font-size: @fs_xs@; border: none; background: transparent;
    padding: @sp_2@ @sp_4@;
}
QToolButton#ErrorDetailsToggle:hover { color: @primary@; background: transparent; }
QPlainTextEdit#ErrorDetails {
    font-family: "DejaVu Sans Mono", "Vazirmatn", monospace; font-size: @fs_xs@;
    background-color: @bg@; border: 1px solid @border@; border-radius: @r_md@;
    color: @text_muted@;
}

/* ============================ confirm dialog ============ */
QLabel#ConfirmBody { font-size: @fs_h2@; line-height: 150%; }
QPlainTextEdit#ConfirmDetails {
    font-family: "DejaVu Sans Mono", "Vazirmatn", monospace; font-size: @fs_xs@;
    background-color: @bg@; border: 1px solid @border@; border-radius: @r_md@;
}
QPushButton#Danger {
    background-color: @overdue@; color: @on_danger@; border: 1px solid @overdue@;
    font-weight: 700;
}
QPushButton#Danger:hover   { background-color: @blocked@; border-color: @blocked@; }
QPushButton#Danger:pressed { background-color: @accent@; }
/* a gated destructive button (purge, behind the phrase field) still reads as
   destructive — greyed fill, but a red edge and label (§ d3 §6.2) */
QPushButton#Danger:disabled{ background-color: @bg_alt@; color: @overdue@;
    border: 1px solid @overdue@; }

/* ============================ M6 — history / raw / stats / timesheet === */
QLabel#FormHint { color: @overdue@; font-size: @fs_xs@; }
QLabel#H2 { font-size: @fs_h2@; font-weight: 700; color: @text@; padding: @sp_2@ 0; }

QTreeWidget#HistoryTree, QTreeWidget#TimesheetTree {
    background-color: @bg@; border: 1px solid @border@; border-radius: @r_md@;
}
QTreeWidget#HistoryTree::item, QTreeWidget#TimesheetTree::item { padding: @sp_4@ @sp_4@; }
QTreeWidget#HistoryTree QHeaderView::section,
QTreeWidget#TimesheetTree QHeaderView::section,
QTableWidget#StatsTable QHeaderView::section {
    background-color: @bg_alt@; color: @text_muted@; border: none;
    border-bottom: 1px solid @border@; padding: @sp_4@ @sp_6@; font-weight: 700;
}
QTableWidget#StatsTable {
    background-color: @bg@; border: 1px solid @border@; border-radius: @r_md@;
}
QTableWidget#StatsTable::item { padding: @sp_4@ @sp_8@; }

QPlainTextEdit#RawJson {
    font-family: "DejaVu Sans Mono", "Vazirmatn", monospace; font-size: @fs_xs@;
    background-color: @bg@; border: 1px solid @border@; border-radius: @r_md@;
}

QLabel#TimerIndicator {
    color: @primary_fg@; background-color: @primary@;
    border-radius: @r_pill@; padding: 1px @sp_8@; font-weight: 700;
}
QLabel#TimerIndicator:hover { background-color: @overdue@; color: @on_danger@; }

QTabWidget#DetailTabs::pane { border: none; }
QTabWidget#DetailTabs QTabBar::tab {
    background: transparent; color: @text_muted@; padding: @sp_6@ @sp_14@;
    border-bottom: 2px solid transparent;
}
QTabWidget#DetailTabs QTabBar::tab:selected {
    color: @text@; border-bottom: 2px solid @primary@;
}

/* ============================ M7 — export / import / sync ============== */
QListWidget#ImportSample {
    background-color: @bg@; border: 1px solid @border@; border-radius: @r_md@;
}
QListWidget#ImportSample::item { padding: @sp_4@ @sp_6@; }

/* ============================ M8 — Taskwarrior managers =============== */
QTableWidget#ConfigTable, QTableWidget#ContextTable,
QTableWidget#UdaTable, QTableWidget#ReportTable {
    background-color: @bg@; border: 1px solid @border@; border-radius: @r_md@;
}
QTableWidget#ConfigTable::item, QTableWidget#ContextTable::item,
QTableWidget#UdaTable::item, QTableWidget#ReportTable::item { padding: @sp_4@ @sp_8@; }
QTableWidget#ConfigTable QHeaderView::section,
QTableWidget#ContextTable QHeaderView::section,
QTableWidget#UdaTable QHeaderView::section,
QTableWidget#ReportTable QHeaderView::section,
QTableWidget#HelpTable QHeaderView::section {
    background-color: @bg_alt@; color: @text_muted@; border: none;
    border-bottom: 1px solid @border@; padding: @sp_4@ @sp_6@; font-weight: 700;
}

/* ============================ toast (d6) ============================= */
QFrame#Toast {
    background-color: @surface@;
    border: 1px solid @border@;
    border-radius: @r_lg@;
}
QLabel#ToastText { color: @text@; font-size: @fs_body@; background: transparent; }
QLabel#ToastIcon { background: transparent; }

/* ============================ M9 — diagnostics / help / calc ========== */
QPlainTextEdit#DiagText {
    font-family: "DejaVu Sans Mono", "Vazirmatn", monospace; font-size: @fs_xs@;
    background-color: @bg@; border: 1px solid @border@; border-radius: @r_md@;
}
QTableWidget#HelpTable {
    background-color: @bg@; border: 1px solid @border@; border-radius: @r_md@;
}
QTableWidget#HelpTable::item { padding: @sp_4@ @sp_8@; }
QLabel#CalcResult {
    font-size: @fs_title@; font-weight: 700; color: @primary@;
    padding: @sp_8@ @sp_2@;
}
